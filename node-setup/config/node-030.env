# node-030.env — config for the 0.3.0+ RAW-NODE architecture. The ONE place to bump per release.
#
# ── WHY THIS FILE EXISTS (architecture change at 0.3.0) ──
# Through 0.2.x a CLI node was the Basecamp `blockchain_module` loaded by `logoscore` (see node.env +
# setup-node.sh). At the 0.3.0 hardfork (2026-09-30) the CLI node ships as a SINGLE self-contained
# binary, `logos-blockchain-node` (nomos-node style): one `user_config.yaml`, an HTTP API, subcommands
# (init-config / participate / generate-key). No logoscore, no lgpd/lgpm, no module .lgx.
#   Release: https://github.com/logos-blockchain/logos-blockchain/releases  (asset:
#            logos-blockchain-node-linux-x86_64-<ver>.tar.gz → a single ELF binary)
# PoW mining + reward/voucher claims are now HTTP endpoints on the node itself (see setup-node-030.sh),
# NOT `logoscore call blockchain_module ...`. Vouchers/leader claim still exist (PoW is ADDITIVE).
#
# ── version (bump per release) ──
NODE_VERSION="0.3.0"        # tag on logos-blockchain/logos-blockchain; also the network id baked into the binary
NODE_RELEASE_REPO="logos-blockchain/logos-blockchain"
NODE_ASSET="logos-blockchain-node-linux-x86_64-${NODE_VERSION}.tar.gz"

# ── bootstrap peers — REFRESH FROM THE TARGET RELEASE'S NOTES / a known-good node EACH TIME ──
# 0.3.0 testnet: same host as 0.2.x (65.109.51.37), ports 3000/3001/3002/50001. VERIFY against a live
# 0.3.0 node's user_config (network.backend.swarm.initial_peers) after each release — they rotate.
BOOTSTRAP_PEERS='[
  "/ip4/65.109.51.37/udp/3000/quic-v1/p2p/12D3KooWFrouXfmrR4nsLMtE7wu15DoMJ6VtoUtHinREZCvbWHar",
  "/ip4/65.109.51.37/udp/3001/quic-v1/p2p/12D3KooWJRGau8M1rjT7R5e4YYsgdFhsMX35nRDtMwCDjxQkXAHz",
  "/ip4/65.109.51.37/udp/3002/quic-v1/p2p/12D3KooWQXJavMDTRscjauFSgVAB1VLB6Rzpy2uY5SU9Tk7927tb",
  "/ip4/65.109.51.37/udp/50001/quic-v1/p2p/12D3KooWSQc7CcGtvWDPF1yCbBthFnQjprfCVHmfmNDUrSmqQsU1"
]'
# ⚠ THE #1 GOTCHA (verified on sneg 2026-09-30): `init-config` leaves network.bootstrap.ibd.peers EMPTY,
# which is a SEPARATE list of bare peer-IDs from initial_peers (multiaddrs). If it stays empty the node
# logs "Skipping IBD as no peers are configured", never runs IBD, and never syncs. setup-node-030.sh
# fills ibd.peers with the peer-IDs below (the /p2p/... tail of each multiaddr above). Keep in sync.
BOOTSTRAP_PEER_IDS='[
  "12D3KooWFrouXfmrR4nsLMtE7wu15DoMJ6VtoUtHinREZCvbWHar",
  "12D3KooWJRGau8M1rjT7R5e4YYsgdFhsMX35nRDtMwCDjxQkXAHz",
  "12D3KooWQXJavMDTRscjauFSgVAB1VLB6Rzpy2uY5SU9Tk7927tb",
  "12D3KooWSQc7CcGtvWDPF1yCbBthFnQjprfCVHmfmNDUrSmqQsU1"
]'

# ── local layout + ports ──
NODE_HOME="${NODE_HOME:-$HOME/logos-node-030}"   # working dir: binary, user_config.yaml, keystore.yaml, logs, state
SWARM_PORT="${SWARM_PORT:-3000}"                 # libp2p udp/quic (use 3010 if running PARALLEL to a live 0.2.x node)
API_PORT="${API_PORT:-8080}"                     # node HTTP API (use 8081 if 8080 is taken by a parallel node)
API="${API:-http://127.0.0.1:${API_PORT}}"
# Shorten only for a caught-up node you want Online fast; upstream default is 3600 (1h) to be safe.
PROLONGED_BOOTSTRAP_SECS="${PROLONGED_BOOTSTRAP_SECS:-3600}"
# For inbound-reachable Blend Core (NOT needed for consensus/PoW): a public /ip4/<ip>/udp/<port>/quic-v1
EXTERNAL_ADDRESS="${EXTERNAL_ADDRESS:-}"

FAUCET_URL="https://testnet.blockchain.logos.co/web/faucet/"
